# Defaults for NODE_ENV, PORT, CORS_ORIGIN, LDAP display-name lookup, and FAVICON_ALLOW_PRIVATE are in backend/config/envDefaults.js — set variables below only to override.
# Behind a reverse proxy, set to 1 so rate limiting and IP-based logic use the client address (X-Forwarded-For).
# Also available under Admin → Settings → Deployment → Advanced (stored with other deployment settings).
# TRUST_PROXY=1
DATA_DIR=./data
JWT_SECRET=change-me
# Optional JWT lifetime for the app bearer token (LDAP + Keycloak). Unset / empty ⇒ no expiry (no exp claim).
# Set e.g. 24h or 365d only if you want automatic sign-out. Keycloak SSO users still get sso:true; Header Logout
# runs Keycloak end-session when SSO is configured (see backend/.env.example Keycloak section).
# JWT_EXPIRES_IN=
LDAP_URL=ldap://example.local
LDAP_SEARCH_BASE=DC=example,DC=local
# Members of this group get JWT isAdmin and appear in the ticket assignee list (GET /api/admin-users).
LDAP_ADMIN_GROUP_DN=CN=homepage-admin,DC=example,DC=local
# Optional: members of this group get Pinger tab + API (admins always have access). If unset, only admins.
# LDAP_PINGER_GROUP_DN=CN=pinger-viewers,DC=example,DC=local
# (Members get read-only Pinger; admins can add/edit/reorder hosts.)
# Pinger: latency at/above this (ms) shows yellow; below = green when up.
# PINGER_WARN_MS=200
# Pinger: cache probe results this long (ms) to avoid ICMP storms.
# PINGER_CACHE_MS=25000
#
# Pinger in-browser SSH: optional port if not 22 (same for all sessions).
# PINGER_SSH_PORT=22
# Older SSH servers may need extra KEX (group-exchange-sha1, group14-sha1); ssh2 adds those automatically.
# Very old gear (group1-sha1, ssh-dss, CBC ciphers): set one of these to 1 (weaker; use only if required).
# PINGER_SSH_LEGACY_ALGORITHMS=1
# PINGER_SSH_ENABLE_LEGACY_KEX=1
# Users type SSH username/password in the UI; no server-side SSH identity is configured here.
#
# Idle session timeout and per-type SSH command snippets: Admin → Settings → Deployment → Pinger.

LDAP_ADMIN=CN=service-user,DC=example,DC=local
LDAP_PASSWORD=change-me
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin123
# Appended to bare usernames on login and ticket import (e.g. corp.example.com → user@corp.example.com). Omit or leave empty to require full UPN or DOMAIN\user.
USER_EMAIL_DOMAIN=corp.example.com
# Optional: for login with sAMAccountName, try DOMAIN\user (e.g. CORP) before UPN. Same as Windows short domain.
# LDAP_NETBIOS_DOMAIN=
# Ticket list still loads if DC is offline: lookups time out and fall back to login names.
# Optional: LDAP_DISPLAY_NAME_LOOKUP, LDAP_LOOKUP_TIMEOUT_MS, LDAP_DISPLAY_NAME_PAUSE_SEC, FAVICON_ALLOW_PRIVATE (see envDefaults.js).
# Favicon fetch: max response body when probing icon URLs (bytes). Default 2097152.
# FAVICON_MAX_IMAGE_BYTES=2097152
# Favicon/page fetch: accept self-signed or mismatched TLS (same pattern as CHECKMK_TLS_INSECURE). Default true in envDefaults; set false to verify certificates.
# FAVICON_TLS_INSECURE=true
# Failure logs (stderr / docker logs): stop emitting tagged [failure] lines after this many bytes per process. Default 10485760.
# FAILURE_LOG_MAX_BYTES=10485760
#
# Checkmk (optional): Admin → Checkmk down hosts. Set CHECKMK_UI=false to hide tab/API regardless of credentials.
# CHECKMK_UI=true
# Base = site root without trailing slash (includes site id path).
# CHECKMK_BASE_URL=https://checkmk.example/mysite
# CHECKMK_AUTOMATION_USER=automation
# CHECKMK_AUTOMATION_SECRET=
# Self-signed TLS from Node/Docker: true (lab only) or install CA and omit this.
# CHECKMK_TLS_INSECURE=true
# CHECKMK_TIMEOUT_MS=15000
# CHECKMK_CACHE_MS=30000
#
# Chat (formerly lobby): set false to hide chat everywhere (and disable API) regardless of Admin → Enable. Docker: LOBBY_CHAT_UI=false
# LOBBY_CHAT_UI=true
# Messages and metadata are pruned after this many days (default 30). See envDefaults.js.
# CHAT_RETENTION_DAYS=30
# Orphan chat uploads + stale read-state rows: run at most once per this interval (ms). Default 3600000 (1h).
# CHAT_GC_INTERVAL_MS=3600000
#
# Keycloak SSO — OIDC Authorization Code flow (Kerberos handled by Keycloak ↔ browser SPNEGO).
# On page load the app redirects here → Keycloak /auth → Negotiate ticket for Keycloak → callback with code → local JWT.
# Do NOT use KEYCLOAK_PROMPT=none for Kerberos SSO: OIDC silent mode usually yields login_required and SPNEGO never runs.
# Leave KEYCLOAK_PROMPT unset unless you intentionally want silent-only (no Kerberos handshake).
#
# Prerequisites: Keycloak Kerberos federation / Identity Provider and client redirect URI whitelist.
#
# KEYCLOAK_ENABLED=true
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=master
# KEYCLOAK_CLIENT_ID=homepage
# KEYCLOAK_CLIENT_SECRET=
# Callback URI — must be whitelisted in Keycloak → Client → Valid redirect URIs (or auto-detected if unset + TRUST_PROXY=1).
# KEYCLOAK_REDIRECT_URI=https://your-app.example.com/api/auth/sso/callback
# After Sign out: landing URL (must appear under Keycloak client → Valid post logout redirect URIs if enforced).
# Default: https://your-host/api/auth/sso/post-logout
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://your-app.example.com/api/auth/sso/post-logout
# Delay (ms) after Keycloak sign-out before the app may redirect to SSO again automatically (Kerberos replay). Default 10000.
# Set 0 to disable. Max 600000.
# KEYCLOAK_SSO_COOLDOWN_AFTER_LOGOUT_MS=10000
#
# Alias of Kerberos Identity Provider in Admin → Identity providers (kc_idp_hint). Omit if unsure; wrong alias ⇒ login_required.
# KEYCLOAK_IDP_HINT=your-kerberos-broker-alias
#
# Rare: KEYCLOAK_PROMPT=none (silent OIDC — breaks most Kerberos browser flows).
# KEYCLOAK_PROMPT=
#
# Keycloak realm role that grants isAdmin. Falls back to LDAP group checks if unset/use admin role. Default: admin
# KEYCLOAK_ADMIN_ROLE=admin
# KEYCLOAK_TIMEOUT_MS=5000
# KEYCLOAK_TLS_INSECURE=false
