# Copy to .env and fill in. Never commit .env.
#
# Password for the local admin account. Leave empty to turn that account off.
LOCAL_ADMIN_PASSWORD=
# Password of the directory account used for LDAP lookups.
LDAP_PASSWORD=
# Checkmk automation secret. Wrap it in single quotes if it has special characters.
CHECKMK_AUTOMATION_SECRET=
# Optional. Leave empty to use a random secret kept in the data volume.
JWT_SECRET=
# Set to 1 only when running behind a reverse proxy.
TRUST_PROXY=0
